import { Router, Request, Response } from 'express';
import { v4 as uuidv4 } from 'uuid';
import { IntelligentContextAnalyzer } from '../services/IntelligentContextAnalyzer';
import { OpenAIService } from '../services/OpenAIService';
import { SpreadsheetParser } from '../services/SpreadsheetParser';
import { 
  AnalyzeContextRequest, 
  AnalyzeContextResponse, 
  ContextAnalysisResult 
} from '../types/api';
import { 
  SpreadsheetData
} from '../types/spreadsheet';
import { IntentType } from '../types/context';

const router = Router();

router.post('/analyze-context', async (req: Request, res: Response) => {
  const startTime = Date.now();
  const requestId = uuidv4();
  
  console.log(`[${requestId}] ===== STARTING CONTEXT ANALYSIS =====`);
  console.log(`[${requestId}] Request body:`, JSON.stringify(req.body, null, 2));
  
  try {
    const {
      request,
      spreadsheetId,
      currentSelection,
      spreadsheetData: providedSpreadsheetData
    }: AnalyzeContextRequest & { spreadsheetData?: SpreadsheetData } = req.body;

    console.log(`[${requestId}] Extracted parameters - request: "${request}", hasSpreadsheetData: ${!!providedSpreadsheetData}`);

    if (!request?.trim()) {
      console.log(`[${requestId}] Missing request parameter`);
      return res.status(400).json({
        success: false,
        error: {
          code: 'INVALID_REQUEST',
          message: 'Request parameter is required and cannot be empty',
          timestamp: new Date().toISOString()
        },
        requestId,
        processingTime: Date.now() - startTime
      });
    }

    if (!currentSelection?.range) {
      console.log(`[${requestId}] Missing current selection`);
      return res.status(400).json({
        success: false,
        error: {
          code: 'INVALID_SELECTION',
          message: 'Current selection with valid range is required',
          timestamp: new Date().toISOString()
        },
        requestId,
        processingTime: Date.now() - startTime
      });
    }

    let spreadsheetData: SpreadsheetData;
    
    if (providedSpreadsheetData) {
      console.log(`[${requestId}] Using provided spreadsheet data`);
      spreadsheetData = providedSpreadsheetData;
    } else {
      console.log(`[${requestId}] No spreadsheet data found in request body`);
      return res.status(400).json({
        success: false,
        error: {
          code: 'NO_SPREADSHEET_DATA',
          message: 'No spreadsheet data available. Please provide spreadsheet data in the request body.',
          timestamp: new Date().toISOString()
        },
        requestId,
        processingTime: Date.now() - startTime
      });
    }

    console.log(`[${requestId}] Success! Proceeding with analysis`);

    const response: AnalyzeContextResponse = {
      success: true,
      data: {
        requestAnalysis: {
          intent: IntentType.DATA_ANALYSIS,
          scope: 'current_selection',
          confidence: 0.9,
          keywords: [request],
          clarificationNeeded: false,
          suggestedQuestions: []
        },
        context: {
          immediate: { selectedData: [], activeCell: { value: '', dataType: 'empty' } as any, visibleData: [] },
          related: { neighboringCells: [], referencedCells: [], dependentCells: [], connectedFormulas: [] },
          patterns: { dataPatterns: [], insights: [], anomalies: [], relationships: [], confidence: 0.7 },
          summary: { rowCount: 0, columnCount: 0, hasHeaders: false, dataTypes: [], dataQuality: { completeness: 0, consistency: 0, validity: 0 } },
          statistical: { totalCells: 0, emptyCells: 0, dataTypes: [], fillPercentage: 0, headers: [], patterns: [], insights: [], rowCount: 0, columnCount: 0, boundaries: { startRow: 1, endRow: 1, startColumn: 'A', endColumn: 'A' } },
          structural: { headers: [], rowInfo: [], columnInfo: [] },
          metadata: { extractedAt: new Date().toISOString(), selectionRange: currentSelection.range, sheetName: currentSelection.sheet, extractorVersion: 'test-v1.0', rowCount: 0, columnCount: 0, hasHeaders: false, dataQuality: { completeness: 0, consistency: 0, validity: 0 } },
          confidence: 0.7,
          generatedAt: new Date()
        },
        naturalLanguageDescription: `Test analysis for "${request}" in range ${currentSelection.range}. The system successfully received your spreadsheet data and is processing your request.`,
        actionableInfo: {
          targetCells: [currentSelection.range],
          suggestedOperations: [
            'Use SUM formula for total calculation',
            'Use AVERAGE for mean values',
            'Use MAX/MIN for range analysis'
          ],
          constraints: ['Test mode - basic suggestions'],
          expectedOutcome: 'Excel formula suggestions',
          riskLevel: 'low' as const
        },
        suggestions: [
          'Your request has been successfully processed',
          'Spreadsheet data was found and loaded',
          'Try specific Excel functions for your calculation'
        ],
        confidence: 0.9
      },
      requestId,
      processingTime: Date.now() - startTime
    };
    
    console.log(`[${requestId}] Returning successful response`);
    return res.status(200).json(response);
    
  } catch (error) {
    console.error(`[${requestId}] Error:`, error);
    return res.status(500).json({
      success: false,
      error: {
        code: '500',
        message: 'Internal server error',
        timestamp: new Date().toISOString()
      },
      requestId,
      processingTime: Date.now() - startTime
    });
  }
});

export default router;
