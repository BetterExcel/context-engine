import express from 'express';
import multer from 'multer';
import fs from 'fs/promises';
import { SpreadsheetParser } from '../services/SpreadsheetParser';
import { ContextFormatter } from '../services/ContextFormatter';
import { OpenAIService } from '../services/OpenAIService';

const router = express.Router();
const upload = multer({ dest: 'uploads/' });

router.post('/analyze-context', upload.single('file'), async (req, res) => {
  console.log('\n=== CONTEXT EXTRACTION REQUEST START ===');
  const startTime = Date.now();
  
  try {
    console.log('Step 1: Parsing request data');
    console.log('Request body:', JSON.stringify(req.body, null, 2));
    
    const {
      request: query,
      selection = {},
      contextOptions = {},
      sessionId,
      spreadsheetId,
      currentSelection = {}
    } = req.body;
    
    // Handle both frontend formats
    const finalSelection = currentSelection.range ? currentSelection : selection;
    
    const parsedSelection = {
      range: finalSelection.range || 'A1',
      startRow: parseInt(finalSelection.startRow) || 1,
      endRow: parseInt(finalSelection.endRow) || 1,
      startCol: parseInt(finalSelection.startCol) || 1,
      endCol: parseInt(finalSelection.endCol) || 1,
      activeCell: finalSelection.activeCell || 'A1',
      sheetName: finalSelection.sheet || finalSelection.sheetName || 'Sheet1'
    };
    
    console.log('Parsed selection:', parsedSelection);
    
    // Get spreadsheet data from storage or upload
    let spreadsheetData;
    
    if (req.file) {
      console.log('Processing uploaded file');
      console.log('File details:', {
        originalName: req.file.originalname,
        mimetype: req.file.mimetype,
        size: req.file.size,
        path: req.file.path
      });
      
      const spreadsheetParser = new SpreadsheetParser();
      spreadsheetData = await spreadsheetParser.parseFile(req.file.path);
    } else if (spreadsheetId) {
      console.log('Getting spreadsheet from storage, ID:', spreadsheetId);
      // Get from storage (assuming we have a storage service)
      const { spreadsheetStorage } = await import('./upload');
      spreadsheetData = spreadsheetStorage.get(spreadsheetId);
      
      if (!spreadsheetData) {
        return res.status(404).json({
          success: false,
          error: {
            code: 'SPREADSHEET_NOT_FOUND',
            message: 'Spreadsheet not found. Please upload a new file.',
            details: { spreadsheetId }
          }
        });
      }
    } else {
      return res.status(400).json({
        success: false,
        error: {
          code: 'MISSING_PARAMETERS',
          message: 'Either a file or spreadsheetId must be provided'
        }
      });
    }
    
    console.log('Spreadsheet data summary:', {
      sheetsCount: spreadsheetData.sheets.length,
      firstSheetName: spreadsheetData.sheets[0]?.name,
      firstSheetRowCount: spreadsheetData.sheets[0]?.data?.length || 0,
      currentSelection: parsedSelection
    });
    
    let contextData;
    try {
      console.log('Step 3: Starting improved context extraction');
      
      const { ImprovedContextExtractor } = await import('../services/ImprovedContextExtractor');
      console.log('Using ImprovedContextExtractor for better accuracy');
      
      contextData = ImprovedContextExtractor.extractRealContext(
        spreadsheetData,
        parsedSelection
      );
      
      console.log('Context extraction completed successfully');
      console.log('Context data summary:', {
        immediateDataCount: contextData.immediate?.selectedData?.length || 0,
        structuralRowCount: contextData.structural?.rowCount || 0,
        summaryFormulaCount: contextData.summary?.formulaCount || 0,
        confidence: contextData.confidence
      });
      
      console.log('DEBUG: Improved context extraction results:');
      console.log('- Immediate context selectedData sample:', 
        JSON.stringify(contextData.immediate?.selectedData?.slice(0, 2)?.map(row => row?.slice(0, 3)) || [], null, 2));
      console.log('- Selection info from context:', 
        JSON.stringify(contextData.immediate?.selectionInfo || {}, null, 2));
      console.log('- Structural headers:', contextData.structural?.headers || []);
      console.log('- Summary data types:', contextData.summary?.dataTypes || {});
      console.log('- Context confidence:', contextData.confidence);
      
    } catch (extractionError) {
      console.error('Context extraction failed:', extractionError);
      console.error('Stack:', extractionError.stack);
      
      contextData = {
        immediate: {
          selectedData: spreadsheetData.sheets[0]?.data?.slice(
            parsedSelection.startRow - 1,
            parsedSelection.endRow
          ) || [],
          selectionInfo: parsedSelection
        },
        structural: {
          headers: spreadsheetData.sheets[0]?.data?.[0] || [],
          rowCount: spreadsheetData.sheets[0]?.data?.length || 0,
          columnCount: spreadsheetData.sheets[0]?.data?.[0]?.length || 0
        },
        summary: {
          totalCells: (spreadsheetData.sheets[0]?.data?.length || 0) * (spreadsheetData.sheets[0]?.data?.[0]?.length || 0),
          formulaCount: 0,
          dataTypes: {}
        },
        confidence: 0.3
      };
      
      console.log('Using fallback context data');
    }
    
    console.log('Step 4: Formatting context for LLM');
    const openaiService = new OpenAIService();
    const contextFormatter = new ContextFormatter(openaiService);
    
    const formattedContext = await contextFormatter.formatForLLM(
      contextData,
      query,
      {
        includeMetadata: true,
        maxTokens: contextOptions.maxTokens || 4000,
        priority: 'accuracy'
      }
    );
    
    console.log('Context formatted successfully, token count:', formattedContext.estimatedTokens);
    
    console.log('Step 5: Generating LLM response');
    const llmResponse = await openaiService.generateContextualResponse(
      query,
      formattedContext.content,
      {
        temperature: 0.7,
        maxTokens: 1000,
        includeExplanation: true
      }
    );
    
    console.log('LLM response generated successfully');
    console.log('Response preview:', llmResponse.content?.substring(0, 200) + '...');
    
    // Clean up uploaded file
    if (req.file?.path) {
      try {
        await fs.unlink(req.file.path);
        console.log('Temporary file cleaned up');
      } catch (cleanupError) {
        console.warn('Could not delete temporary file:', cleanupError);
      }
    }
    
    const processingTime = Date.now() - startTime;
    console.log(`Total processing time: ${processingTime}ms`);
    
    // Format response to match frontend expectations
    const response = {
      success: true,
      data: {
        analysis: llmResponse.content,
        requestAnalysis: {
          intent: 'general_assistance',
          scope: 'current_selection',
          confidence: contextData.confidence
        },
        spreadsheetContext: {
          currentSelection: {
            range: parsedSelection.range,
            data: contextData.immediate?.selectedData || [],
            dataTypes: Object.keys(contextData.summary?.dataTypes || {})
          },
          relatedFormulas: [],
          dependencies: [],
          dataSummary: {
            rowCount: contextData.structural?.rowCount || 0,
            patterns: [],
            statistics: contextData.summary || {}
          }
        },
        actionableInfo: {
          targetCells: [parsedSelection.activeCell],
          suggestedOperations: ['ANALYZE'],
          constraints: []
        },
        naturalLanguageDescription: `Analysis of request: "${query}" for selection ${parsedSelection.range}`,
        requestId: `req_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`
      }
    };
    
    console.log('Response prepared successfully');
    console.log('=== CONTEXT EXTRACTION REQUEST END ===\n');
    
    res.json(response);
    
  } catch (error) {
    console.error('Context extraction error:', error);
    console.error('Stack:', error.stack);
    console.log('=== CONTEXT EXTRACTION REQUEST FAILED ===\n');
    
    if (req.file?.path) {
      try {
        await fs.unlink(req.file.path);
      } catch (cleanupError) {
        console.warn('Could not delete temporary file after error:', cleanupError);
      }
    }
    
    res.status(500).json({
      success: false,
      error: {
        code: 'INTERNAL_SERVER_ERROR',
        message: 'Failed to extract context from spreadsheet',
        details: error.message
      }
    });
  }
});

router.get('/health', (req, res) => {
  res.json({ status: 'ok', service: 'context-extraction' });
});

export default router;
