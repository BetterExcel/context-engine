# Environment Variables for vansh-test Context Engine
# Copy this file to .env and fill in your actual values

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API Key (required for semantic search and LLM processing)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone API Key (required for vector database operations)
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Environment (e.g., "us-east-1-aws")
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# =============================================================================
# FILE PATHS (optional - defaults provided)
# =============================================================================

# Path to the Excel file to process
EXCEL_FILE_PATH=test.xlsx

# Path for anchored index output
ANCHORED_INDEX_OUTPUT_PATH=anchored_index_output.json

# Path for dynamic index output
DYNAMIC_INDEX_OUTPUT_PATH=dynamic_index_output.json

# Path for consolidated fields output
CONSOLIDATED_FIELDS_PATH=consolidated_fields.json

# =============================================================================
# PINECONE CONFIGURATION
# =============================================================================

# Pinecone index name
PINECONE_INDEX_NAME=skopeo-context-index-dense

# OpenAI embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# SEARCH CONFIGURATION (optional)
# =============================================================================

# Default top-k results for search
DEFAULT_TOP_K=5

# Default chunk size for processing
DEFAULT_CHUNK_SIZE=50

# =============================================================================
# THRESHOLD CONFIGURATION (optional)
# =============================================================================

# Semantic search threshold (below this triggers dynamic extraction)
SEMANTIC_THRESHOLD=0.6

# Lexical search threshold (below this triggers dynamic extraction)
LEXICAL_THRESHOLD=1.0

# Combined threshold for hybrid search
COMBINED_THRESHOLD=0.4

# =============================================================================
# CHUNK PROCESSING CONFIGURATION
# =============================================================================

# Number of rows per chunk (default: 50)
CHUNK_SIZE=50

# Overlap percentage between chunks (default: 5%)
CHUNK_OVERLAP_PERCENT=5.0
